{
  "api": 2,
  "mode": "companion",
  "id": "kt_tracker",
  "name": "Kill Task Tracker",
  "short_name": "KT",
  "version": "5.2.3",
  "description": "Kill-task tracker: tasks by area with your progress, quest-giver markers by state, green arrows and an auto NAV arrow to the closest task monster, and your quest list saved per character and server.",
  "presentation": {
    "title": "Kill Task Tracker",
    "icon": "kt.png",
    "controls": "none",
    "settings": false,
    "status": true
  },
  "update_interval": 0.5,
  "snapshot_fields": ["chat_events", "chat_latest_serial", "chat_pending", "chat_gap", "chat_dropped",
    "objects", "position", "character_name"],
  "chat_history": false,
  "chat_subscriptions": [
    {"id": "quest_list", "contains": " solves (", "sender_type": "server"},
    {"id": "kills", "contains": "killed", "sender_type": "server"},
    {"id": "stamps", "contains": "stamped", "sender_type": "server"},
    {"id": "rewards", "contains": " experience", "sender_type": "server"},
    {"id": "task_start", "contains": "of these", "sender_type": "server"},
    {"id": "cooldowns", "contains": "again in", "sender_type": "server"},
    {"id": "myquests", "contains": "myquests", "sender_type": "server"},
    {"id": "quests_empty", "contains": "Quest list is empty", "sender_type": "server"},
    {"id": "npcs", "sender_type": "npc"},
    {"id": "vendors", "sender_type": "vendor"}
  ],
  "permissions": [
    "chat",
    "chat_filter",
    "state",
    "ui",
    "markers",
    "waypoint",
    "profiles",
    "say",
    "data"
  ],
  "settings": []
}
